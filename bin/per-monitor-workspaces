#!/bin/bash

# Turn Omarchy's per-monitor workspaces (omacom/omarchy#15655) on or off.
# Off numbers workspaces 1-10 across all monitors, as Omarchy did before.

set -euo pipefail

usage() {
  echo "Usage: per-monitor-workspaces [toggle|on|off|status|menu]" >&2
}

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
script="$plugin_dir/bin/per-monitor-workspaces"
menu_file="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
menu_begin="  // >>> per-monitor-workspaces: written by the plugin, edits here are replaced"
menu_end="  // <<< per-monitor-workspaces"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
flag="$state_dir/toggles/hypr/per-monitor-workspaces-off.lua"
blocks_file="$state_dir/monitor-workspaces"
saved_blocks_file="$blocks_file.per-monitor"

enabled() {
  [[ ! -f $flag ]]
}

print_status() {
  if enabled; then
    echo on
  else
    echo off
  fi
}

# The flag only points at the plugin's Lua, so updating the plugin needs no
# re-toggle, and removing the plugin leaves a flag that loads nothing.
off() {
  mkdir -p "$(dirname "$flag")"
  cat >"$flag" <<EOF
-- Written by per-monitor-workspaces; delete to turn per-monitor workspaces back on.
local path = [==[$plugin_dir/hypr/global-workspaces.lua]==]
local file = io.open(path, "r")
if file then
  file:close()
  dofile(path)
end
EOF
}

# While off, the bar's block file holds a flat stand-in, and the real one waits
# beside it. It has to be back before Hyprland reloads and reads it.
on() {
  enabled && return
  rm -f "$flag"

  if [[ -f $saved_blocks_file ]]; then
    mv -f "$saved_blocks_file" "$blocks_file"
  else
    rm -f "$blocks_file"
  fi
}

# Omarchy's menu only reads its defaults and the user's extension file, so the
# Trigger > Toggle rows live in a marked block there. Rewriting the block keeps
# the script path current when the plugin moves, and the rows hide themselves
# once the script is gone.
menu() {
  # The path lands unescaped inside a JSON string and a single-quoted shell word.
  if [[ $script == *[\"\'\\]* ]]; then
    echo "Plugin path contains a quote or backslash, menu rows not added: $script" >&2
    return 1
  fi

  if [[ ! -f $menu_file ]]; then
    mkdir -p "$(dirname "$menu_file")"
    printf '{\n}\n' >"$menu_file"
  fi

  local status_check="\$('$script' status 2>/dev/null)"
  local block
  block=$(cat <<EOF
$menu_begin
  "trigger.toggle.per-monitor-workspaces-global": {"icon":"󰍹","label":"Global Workspaces","when":"[[ $status_check == on ]]","action":"'$script' toggle"},
  "trigger.toggle.per-monitor-workspaces-per-monitor": {"icon":"󰍺","label":"Per-monitor Workspaces","when":"[[ $status_check == off ]]","action":"'$script' toggle"},
$menu_end
EOF
  )

  local updated
  updated=$(awk -v begin="$menu_begin" -v end="$menu_end" -v block="$block" '
    $0 == begin { skipping = 1; next }
    skipping { if ($0 == end) skipping = 0; next }
    { print }
    !inserted && /^[[:space:]]*\{[[:space:]]*$/ { print block; inserted = 1 }
    END { if (!inserted) exit 1 }
  ' "$menu_file") || {
    echo "No opening { line in $menu_file, menu rows not added" >&2
    return 1
  }

  if [[ $updated != "$(cat "$menu_file")" ]]; then
    printf '%s\n' "$updated" >"$menu_file"
  fi
}

case "${1:-toggle}" in
  status)
    print_status
    exit 0
    ;;
  menu)
    menu
    exit 0
    ;;
  on) on ;;
  off) off ;;
  toggle)
    if enabled; then
      off
    else
      on
    fi
    ;;
  *)
    usage
    exit 1
    ;;
esac

workspace_ids() {
  hyprctl workspaces -j 2>/dev/null | jq -c '[.[].id] | sort' || true
}

before=$(workspace_ids)
omarchy-restart-hyprctl
print_status

# Switching renumbers workspaces, and Quickshell keeps listing the old numbers
# in the bar until it restarts.
if [[ $(workspace_ids) != "$before" ]]; then
  omarchy-restart-shell >/dev/null 2>&1 &
  disown
fi
